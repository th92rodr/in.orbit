{
  "name": "in-orbit-server",
  "version": "1.0.0",
  "author": "https://github.com/th92rodr",
  "license": "BSD-3-Clause",
  "description": "",
  "type": "module",
  "main": "src/http/server.ts",
  "engines": {
    "node": "20.16.0",
    "npm": "10.8.1"
  },
  "scripts": {
    "dev": "tsx watch --env-file .env src/http/server.ts",
    "build": "tsup-node",
    "start": "node --env-file .env dist/http/server.js",

    "db:generate-migrations": "drizzle-kit generate",
    "db:execute-migrations": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file .env src/db/seed.ts",

    "docker:up": "docker compose --env-file .env --file tools/docker-compose.yml up -d",
    "docker:down": "docker compose --env-file .env --file tools/docker-compose.yml down"
  },
  "dependencies": {
    "@fastify/cors": "9.0.1",
    "@paralleldrive/cuid2": "2.2.2",
    "dayjs": "1.11.12",
    "drizzle-orm": "0.33.0",
    "fastify": "4.28.1",
    "fastify-type-provider-zod": "2.0.0",
    "postgres": "3.4.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.2.0",
    "drizzle-kit": "0.24.0",
    "tsup": "8.5.0",
    "tsx": "4.17.0",
    "typescript": "5.5.4"
  }
}
